# Copy this file to .env and fill in real values.
# .env itself is already in .gitignore — never commit real credentials.

PORT=3000
NODE_ENV=development

# Get these from Railway: your project -> Postgres service -> "Connect" tab
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Used to sign and verify JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of frontend origins allowed to call this API.
# The React app runs on http://localhost:5173 by default (Vite).
CORS_ORIGINS=http://localhost:5173
